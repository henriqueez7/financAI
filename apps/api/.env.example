DATABASE_URL="postgresql://usuario:senha@localhost:5432/nome_do_banco?schema=public"

PORT=3333
# Em produção, informe somente a origem HTTPS, sem caminho ou credenciais.
FRONTEND_URL="http://localhost:3000"

# Padrão seguro: não confiar em proxies. Em produção, prefira IPs/CIDRs
# conhecidos separados por vírgula. Um número de saltos só é seguro quando
# a API não pode ser acessada sem passar pela cadeia fixa de proxies.
TRUST_PROXY=0

# Use pelo menos 32 caracteres em produção. Tokens expiram em 24 horas.
JWT_SECRET="adicione-uma-chave-segura"

# Somente no backend. Nunca use NEXT_PUBLIC_ para esta chave.
OPENAI_API_KEY="adicione-sua-chave-da-openai"
OPENAI_MODEL="gpt-5.4-mini"
NODE_ENV=development
