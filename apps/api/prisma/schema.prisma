generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String

  accounts          Account[]
  categories        Category[]
  entries           Entry[]
  budgets           Budget[]
  goals             Goal[]
  goalContributions GoalContribution[]
  pendingFinancialActions PendingFinancialAction[]
  whatsappConnections    WhatsAppConnection[]
  whatsappLinkChallenges WhatsAppLinkChallenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Account {
  id             String      @id @default(uuid())
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @db.Decimal(12, 2)
  isActive       Boolean     @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries Entry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("accounts")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  type      EntryType
  icon      String?
  color     String?
  isActive  Boolean   @default(true)
  isDefault Boolean   @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries Entry[]
  budgets Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

model Entry {
  id          String      @id @default(uuid())
  description String
  amount      Decimal     @db.Decimal(12, 2)
  type        EntryType
  status      EntryStatus @default(PENDING)
  source      EntrySource @default(WEB)

  dueDate     DateTime
  completedAt DateTime?
  notes       String?
  externalId  String?   @unique

  userId     String
  accountId  String?
  categoryId String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueDate])
  @@index([userId, type, status])
  @@index([accountId])
  @@index([categoryId])
  @@map("entries")
}

model Budget {
  id     String  @id @default(uuid())
  amount Decimal @db.Decimal(12, 2)
  month  Int
  year   Int

  userId     String
  categoryId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
  @@map("budgets")
}

model Goal {
  id           String     @id @default(uuid())
  name         String
  description  String?
  targetAmount Decimal    @db.Decimal(12, 2)
  targetDate   DateTime?
  status       GoalStatus @default(ACTIVE)
  icon         String?
  color        String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contributions GoalContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, targetDate])
  @@map("goals")
}

model GoalContribution {
  id     String   @id @default(uuid())
  amount Decimal  @db.Decimal(12, 2)
  date   DateTime @default(now())
  notes  String?

  goalId String
  userId String

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([goalId, date])
  @@index([userId])
  @@map("goal_contributions")
}

model PendingFinancialAction {
  id        String                       @id @default(uuid())
  type      PendingFinancialActionType
  payload   Json
  status    PendingFinancialActionStatus @default(PENDING)
  expiresAt DateTime

  confirmedAt DateTime?
  cancelledAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, expiresAt])
  @@index([expiresAt])
  @@map("pending_financial_actions")
}

model WhatsAppConnection {
  id          String                   @id @default(uuid())
  phoneNumber String                   @unique
  waId        String                   @unique
  status      WhatsAppConnectionStatus @default(PENDING)
  verifiedAt  DateTime?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("whatsapp_connections")
}

model WhatsAppLinkChallenge {
  id            String                      @id @default(uuid())
  lookupKey     String                      @unique
  codeHash      String                      @unique
  status        WhatsAppLinkChallengeStatus @default(PENDING)
  attempts      Int                         @default(0)
  maxAttempts   Int                         @default(5)
  expiresAt     DateTime
  consumedAt    DateTime?
  cancelledAt   DateTime?
  activeUserKey String?                     @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, expiresAt])
  @@index([expiresAt])
  @@map("whatsapp_link_challenges")
}

model WhatsAppMessage {
  id          String                   @id @default(uuid())
  messageId   String                   @unique
  direction   WhatsAppMessageDirection
  type        WhatsAppMessageType      @default(TEXT)
  status      WhatsAppMessageStatus
  receivedAt  DateTime?
  processedAt DateTime?

  connectionId String?
  connection   WhatsAppConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([connectionId, createdAt])
  @@map("whatsapp_messages")
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  INVESTMENT
  DIGITAL_WALLET
  OTHER
}

enum EntryType {
  INCOME
  EXPENSE
}

enum EntryStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum EntrySource {
  WEB
  WHATSAPP
  IMPORT
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum PendingFinancialActionType {
  CREATE_EXPENSE
  CREATE_INCOME
}

enum PendingFinancialActionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum WhatsAppConnectionStatus {
  PENDING
  VERIFIED
  REVOKED
}

enum WhatsAppLinkChallengeStatus {
  PENDING
  CONSUMED
  CANCELLED
  EXPIRED
  BLOCKED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  INTERACTIVE
}

enum WhatsAppMessageStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}
